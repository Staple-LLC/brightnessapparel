# Dependencies and build output — regenerated by `npm install` / `vite build`,
# so committing them only produces conflicts on every build.
node_modules/
dist/
*.tsbuildinfo

# macOS
.DS_Store

# Portfolio originals.
#
# src/assets/portfolio/*.png is ~40 MB of full-resolution PNG. Only the WebP
# renders under cards/ and full/ are shipped — the PNGs are the masters that
# scripts/convert-portfolio.py reads.
#
# Uncomment the line below to keep them out of the repository. Do that only
# once the originals are backed up somewhere else: git history is permanent,
# so 40 MB committed once stays in every future clone, but a file that is
# ignored and then lost is gone.
# src/assets/portfolio/*.png

# Local environment (VITE_ vars are public, but keep local overrides out of git)
.env
.env.local

